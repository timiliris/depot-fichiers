# sshd instance dedicated to SFTP. DO NOT merge into /etc/ssh/sshd_config.
#
# The reason is simple: the sshd on port 22 also serves administrative logins.
# Adding SFTP accounts to it would mean exposing that port to hand out a drop
# account, which puts the root login in the path of automated scanning. A second
# instance on its own port keeps the two apart.

Port 2223
# Restricted listen address: here, the interface the relay arrives on.
ListenAddress 0.0.0.0
PidFile /run/sshd-sftp.pid

HostKey /etc/ssh/ssh_host_ed25519_key
HostKey /etc/ssh/ssh_host_rsa_key

LogLevel INFO
SyslogFacility AUTH

PermitRootLogin no
AllowGroups sftpusers
PasswordAuthentication yes
PubkeyAuthentication yes
KbdInteractiveAuthentication no
UsePAM yes
MaxAuthTries 3
MaxStartups 10:30:60
LoginGraceTime 30

X11Forwarding no
AllowTcpForwarding no
AllowAgentForwarding no
PermitTunnel no
GatewayPorts no
PermitUserRC no

ClientAliveInterval 60
ClientAliveCountMax 30

Subsystem sftp internal-sftp -u 0002

Match Group sftpusers
    ChrootDirectory /srv/depot/%u
    ForceCommand internal-sftp -u 0002
